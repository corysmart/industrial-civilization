{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "config",
    "status",
    "entries"
  ],
  "properties": {
    "status": { "enum": ["active", "replaced"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "milestone_id", "runtime_item", "display_name", "replacement_status", "implementation"],
        "properties": {
          "replacement_status": { "enum": ["implemented"] }
        }
      }
    }
  }
}
