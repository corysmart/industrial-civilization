{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Industrial Civilization side path",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "number",
    "title",
    "purpose",
    "milestones"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "milestone.schema.json"
      }
    }
  }
}
